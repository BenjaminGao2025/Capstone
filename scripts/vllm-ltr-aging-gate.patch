     def _update_opt_priority(self):
         pass
 
+    def _get_opt_aging_ordered_requests(self):
+        """OPT with waiting-time aging gate (OOD tail-latency mitigation).
+
+        Any request whose wall-clock waiting time exceeds AGING_GATE_S
+        seconds is escalated to FCFS priority, overriding its LTR rank.
+        Among aged requests, earliest-arrival goes first (pure FCFS).
+        Non-aged requests keep normal LTR order (highest score first).
+
+        Threshold proxy:
+          AGING_GATE_S (env var, default 120s) approximates W=8 from
+          the single-server simulation (confidence_gate_sim.py).  The sim
+          used W * abstract mean_service_time; real-world mapping is
+          approximate because TTFT ≠ pure service time (includes
+          queuing delay).  See docs/experiments/ for derivation.
+
+        Gate trigger count is logged so post-hoc analysis can confirm
+        the gate is actually activating under OOD load.
+        """
+        # 1. Score unscored waiting requests via aux model (same as OPT)
+        need_aux_scores = [r for r in self.waiting
+                          if r.need_aux_model_score()]
+        if need_aux_scores:
+            self.aux_model.obtain_aux_scores(need_aux_scores)
+
+        # 2. Aging gate threshold (wall-clock seconds)
+        aging_s = float(os.environ.get("AGING_GATE_S", "120"))
+        now = time.time()
+
+        all_reqs = (list(self.waiting) + list(self.running)
+                    + list(self.swapped))
+
+        n_aged = 0
+        waiting_ids = set(id(r) for r in self.waiting)
+
+        def _key(req):
+            nonlocal n_aged
+            is_waiting = id(req) in waiting_ids
+            waited = now - req.metrics.arrival_time
+            if is_waiting and waited >= aging_s:
+                n_aged += 1
+                # Tier 0: aged → FCFS by arrival time
+                return (0, req.metrics.arrival_time, 0.0)
+            else:
+                # Tier 1: normal LTR → highest aux_model_score first
+                return (1, 0.0, -req.aux_model_score)
+
+        ret = list(sorted(all_reqs, key=_key))
+
+        if n_aged > 0:
+            logger.info("aging-gate: %d/%d waiting requests exceeded %.0fs threshold",
+                        n_aged, len(self.waiting), aging_s)
+
+        return ret
+
+
+
